# Copy to .env.local for local development. On Vercel, set these under
# Project > Settings > Environment Variables instead. Never commit real values.

# Supabase > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase > Project Settings > API Keys > Publishable key (starts with sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
